# Blossom Counseling admin panel - environment variables (never commit this file)

DB_HOST=127.0.0.1
DB_NAME=blossom_counseling
DB_USER=root
DB_PASS=

# Secret used to sign login tokens (JWT). Keep it long and private.
# Changing it logs every admin out.
JWT_SECRET=change-me-to-a-long-random-string
# Login token lifetime in minutes
TOKEN_TTL_MINUTES=120

# Gmail SMTP - used to send the 6-digit password reset code.
# Use a Google "App Password" (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=Blossom Counseling
